# Environment: dev seeds test players. Never set to dev in prod.
APP_ENV=dev
# Dev tools: enables the admin DB-reset tool (Configuración)
APP_DEV_TOOLS=true

# PocketBase superuser (/_/)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-strong-password

# App Admin 1 (required)
APP_ADMIN1_EMAIL=admin1@example.com
APP_ADMIN1_PASSWORD=change-me
APP_ADMIN1_NAME=Admin

# App Admin 2 (optional)
# APP_ADMIN2_EMAIL=admin2@example.com
# APP_ADMIN2_PASSWORD=change-me
# APP_ADMIN2_NAME=Admin 2

# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMTP (Gmail recommended — see .claude/deployment/smtp-setup.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_ADDRESS=your-account@gmail.com
SMTP_SENDER_NAME=Padel League
# APP_URL is used in email links (verify, reset password)
APP_URL=https://www.mypadellegue.com

# Email backup: every 12h, a zip of pb_data/ is emailed to BACKUP_EMAIL via
# the SMTP settings above. Empty BACKUP_EMAIL disables it.
# BACKUP_EMAIL=you@example.com
# BACKUP_ENCRYPTION_KEY is REQUIRED to send a backup (refuses to send
# unencrypted, in every environment). Used as the openssl passphrase —
# decrypt a downloaded backup.zip.enc with:
#   openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:<key> -in backup.zip.enc -out backup.zip
# BACKUP_ENCRYPTION_KEY=

